        return POWER_BIZ_WORDS
    return tuple(SEG_SUPPLEMENT.get(theme_key, ()))


# 通道口径：行业 / 概念整包倒入（非人工确认）
BASKET_VIA = {
    'dc_industry_board', 'dc_industry', 'stock_basic_industry',
    'stock_basic_industry_alias', 'sw_industry', 'sw_industry_board',
    'concept_fallback', 'ths_concept', 'concept_only', 'concept_as_industry',
}
CURATED_VIA = {'leader_company', 'core_company', 'manual_override'}


def read_csv(path):
    if not os.path.exists(path):
        return []
    with open(path, 'r', encoding='utf-8-sig', newline='') as f:
        return list(csv.DictReader(f))


def write_csv(path, fieldnames, rows):
    with open(path, 'w', encoding='utf-8-sig', newline='') as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        w.writerows(rows)
    print(f'  -> {os.path.basename(path)}（{len(rows)} 行）')


def R(cls, ev_type, evidence, conf, action, reason):
    return {
        'classification': cls, 'evidence_type': ev_type, 'evidence': evidence,
        'confidence': conf, 'manual_action': action, 'reason': reason,
    }


def match_industry(segs, industry):
    """P3：成员行业命中环节的窄口径 industries 白名单"""
    if not industry:
        return ''
    for seg in segs:
        if industry in (seg.get('industries') or []):
            return seg.get('name', '')
    return ''


def match_theme_industry(cfg, industry, theme_key=''):
    """股票行业是否落在主题的行业口径内（配置 sw/cx_industry_match，双向子串匹配）。

    用于保守兜底分支：行业仍属主题范围 → UNCERTAIN（证据不足，不得误杀）；
    行业明显不属主题范围 → EXCLUDE（明确反证）。
    THEME_IND_EXTRA 为审计侧补充（20260927），仅在此兜底处生效，不参与正向纳入。
    """
    if not industry:
        return False
    for key in ('sw_industry_match', 'cx_industry_match'):
        for kw in ((cfg.get(key) or []) + THEME_IND_EXTRA.get(theme_key, [])):
            if kw and (kw in industry or industry in kw):
                return True
    return False


def classify(theme_key, cfg, code, name, via, industry, mainbiz):
    leaders = set(cfg.get('leaders') or []) | set(cfg.get('core_stocks') or [])
    segs = cfg.get('segments') or []
    tier_map = SEG_TIER.get(theme_key, {})
    tstat = text_status(mainbiz)

    # 1) 正向证据：环节关键词（优先主题） / 主题关键词（其余主题）
    #    hits = 强证据（直连本体/产业链的专用词）
    #    generic_hits = 泛化词（黑名单，见 SEG_KW_GENERIC）→ 只能进弱证据通道
    hits, name_hits, generic_hits = [], [], []
    if segs:
        gen_map = SEG_KW_GENERIC.get(theme_key, {})
        for seg in segs:
            sname = seg.get('name', '')
            tier = tier_map.get(sname, 'CHAIN')
            gen = set(gen_map.get(sname) or [])
            kws = list(seg.get('keywords') or [])
            for kw in kws:
                if not kw:
                    continue
                if mainbiz and kw in mainbiz:
                    (generic_hits if kw in gen else hits).append((kw, tier, sname))
                elif name and kw in name:
                    name_hits.append((kw, tier, sname))
    else:
        for kw in (cfg.get('core_keywords') or []):
            if kw and mainbiz and kw in mainbiz:
                hits.append((kw, 'CORE', '核心关键词'))
        for key in ('product_keywords', 'keywords', 'industry_chains'):
            for kw in (cfg.get(key) or []):
                if kw and mainbiz and kw in mainbiz:
                    hits.append((kw, 'CHAIN', f'{key}'))
        for kw in (cfg.get('brand_keywords') or []):
            if kw and name and kw in name:
                name_hits.append((kw, 'CHAIN', 'brand_keywords'))

    # 2) 配置人工名单：只定义优先级（成员资格），层级按主营环节证据校正
    #    （20260927 修正：原直接产出 CORE 会绕过环节分层，使 PCB 等产业链环节被标为本体）
    if code in leaders:
        tier, ev = 'CORE', '配置人工名单（leaders / core_stocks）'
        if hits:
            best = max(hits, key=lambda x: len(x[0]))
            tier, ev = best[1], f'人工名单 + 主营命中环节「{best[2]}」关键词：{best[0]}'
        return R(tier, '其他', ev, 'HIGH', 'KEEP', '人工名单定优先级，层级按主营环节证据校正')

    # 强证据：环节/主题关键词命中（最长命中定级，越具体越优先，避免泛词升级为 CORE）
    if hits:
        best = max(hits, key=lambda x: len(x[0]))
        return R(best[1], '主营' if segs else ('核心产品' if 'product' in best[2] else '主营'),
                 f'主营命中环节「{best[2]}」关键词：{best[0]}', 'HIGH', 'KEEP',
                 '主营文本明确指向该环节')

    # 3) 数据缺口（规格 §二 C：主营文本缺失 → UNCERTAIN，不得直接判 BAD）
    if tstat:
        p3 = match_industry(segs, industry)
        if p3:
            return R('UNCERTAIN', '环节行业',
                     f'行业「{industry}」属环节「{p3}」；主营文本{ TEXT_STATUS_CN[tstat] }',
                     'LOW', 'REVIEW', '文本缺口，行业口径仅供参考（不判 BAD / 不入 Heat）')
        return R('UNCERTAIN', '主营', f'主营文本{ TEXT_STATUS_CN[tstat] }，无可用业务描述',
                 'LOW', 'REVIEW', '数据缺口，保留待补录（不判 BAD）')

    # 4) 弱证据通道（20260927 修正）：公司简称命中 / 宽口径产业链证据 / 环节行业归属
    #    —— 一律不得单独定级。
    #    按「证据通道」计数（同一通道多个词只算一条，避免同一泛化语义被重复计数）：
    #    单一通道 → UNCERTAIN；两条及以上**独立**通道互证 → CHAIN。
    #    「独立」口径（20260927 第二轮修正，规格 §表5-1「需第二条独立证据」）：
    #      经营层业务词 与 泛化环节词 同属「宽口径产业链证据」这一证据族，
    #      二者不得互为第二条独立证据（否则同一 PCB/光伏语义被重复计数两次）。
    #    依据：军工宽口径产业链词无证据即入链（12/20）、电力环节行业豁免过宽、
    #          AI算力/消费简称命中误纳（亿能电力等）、光弘科技 PCB 双计。
    weak = {}
    if name_hits:
        nb = max(name_hits, key=lambda x: len(x[0]))
        weak['公司简称命中'] = f'「{nb[2]}」关键词：{nb[0]}'
    wide = []
    bw = [w for w in _biz_words(theme_key) if w in mainbiz]
    if bw:
        wide.append(max(bw, key=len))
    if generic_hits:
        wide.append(max(generic_hits, key=lambda x: len(x[0]))[0])
    if wide:
        weak['宽口径产业链证据'] = f'产业链：{max(wide, key=len)}'
    p3 = match_industry(segs, industry)
    if p3:
        weak['环节行业归属'] = f'「{industry}」属环节「{p3}」'
    has_ind = '环节行业归属' in weak
    if len(weak) >= 2:
        best = max(weak.items(), key=lambda kv: len(kv[1]))
        return R('CHAIN', '环节行业' if has_ind else '弱证据交叉',
                 f'弱证据交叉印证（{"、".join(weak)}）：{best[1]}',
                 'MEDIUM', 'REVIEW', '两条独立弱证据互证，暂列 CHAIN 待人工确认')
    if len(weak) == 1:
        k, v = next(iter(weak.items()))
        return R('UNCERTAIN', '环节行业' if has_ind else '弱证据',
                 f'仅单一弱证据（{k}）：{v}', 'LOW', 'REVIEW',
                 f'弱证据通道「{k}」不得单独定级，需第二条独立证据')

    # 5) 明确反证：exclude_keywords
    neg = [w for w in (cfg.get('exclude_keywords') or []) if w and mainbiz and w in mainbiz]
    if neg:
        return R('EXCLUDE', '主营', f'主营明确为排除项：{neg[0]}', 'HIGH', 'EXCLUDE',
                 'exclude_keywords 构成明确反证')

    # 6) 保守兜底（20260927 修正）：主营无主题业务证据时不得直接 EXCLUDE，按行业归属判定。
    #    依据：消费 7 例真实成分股（膳食营养/家电零部件/家居/服饰/文教/自行车）与电力
    #          1 例（白云电器·输配电设备）被「dc_industry_board」整包一刀切误判 EXCLUDE。
    if via in BASKET_VIA:
        if match_theme_industry(cfg, industry, theme_key):
            return R('UNCERTAIN', '其他',
                     f'仅经「{via}」行业「{industry}」纳入，主营无主题业务证据',
                     'LOW', 'REVIEW',
                     '保守兜底：行业口径仍属主题范围，证据不足转待复核（不判排除）')
        return R('EXCLUDE', '其他',
                 f'仅经「{via}」纳入，行业「{industry}」不在主题行业范围，主营无主题业务证据',
                 'MEDIUM', 'REVIEW', '行业与主营均无主题归属证据')
    if via in CURATED_VIA:
        return R('UNCERTAIN', '其他', f'人工名单来源「{via}」但主营无主题证据',
                 'MEDIUM', 'REVIEW', '来源可信但证据不足')
    return R('UNCERTAIN', '其他', f'经「{via}」纳入，主营无明确主题证据', 'LOW', 'REVIEW',
             '证据不足，需人工复核')


def main():
    print('=' * 68)
    print(f'主题成份股 Mapping V3 审计　交易日 {TRADE_DATE}')
    print('=' * 68)

    with open(CFG_PATH, 'r', encoding='utf-8') as f:
        cfg_all = json.load(f)
    with open(os.path.join(CACHE, 'stock_company_mainbiz.json'), 'r', encoding='utf-8') as f:
        mainbiz_map = json.load(f)

    key_by_cn, cfg_by_cn = {}, {}
    for k, v in cfg_all.items():
        if k.startswith('_'):
            continue
        cn = v.get('name_cn', k)
        key_by_cn[cn] = k
        cfg_by_cn[cn] = v
    print(f'  主题配置: {len(cfg_by_cn)} 个　主营文本: {len(mainbiz_map)} 只')

    pool = read_csv(os.path.join(RD, f'theme_pregate_pool_{TRADE_DATE}.csv'))
    prod = read_csv(os.path.join(RD, f'theme_stock_map_v2_{TRADE_DATE}.csv'))
    dropped_seg = read_csv(os.path.join(RD, f'theme_segment_dropped_{TRADE_DATE}.csv'))
    dropped_pol = read_csv(os.path.join(RD, f'theme_pollution_dropped_{TRADE_DATE}.csv'))
    hc_rows = read_csv(os.path.join(RD, f'theme_mapping_hc_v1_{TRADE_DATE}_members.csv'))
    with open(os.path.join(RD, f'theme_heat_v24_{TRADE_DATE}.json'), 'r', encoding='utf-8') as f:
        heat_rows = json.load(f)

    seg_drop_set = {(r['theme'], r['code']) for r in dropped_seg}
    pol_drop_set = {(r['theme'], r['code']) for r in dropped_pol}
    prod_set = {(r['主题'], r['股票代码']) for r in prod}  # 仅用于对照（gated 主题该文件为旧产物）
    hc_map = {(r['theme'], r['code']): r.get('cls', '') for r in hc_rows}
    heat_map = {r['theme']: r for r in heat_rows}
    print(f'  原池(门槛前) {len(pool)} 条　生产映射 {len(prod)} 条　'
          f'环节门槛剔除 {len(seg_drop_set)} 条　污染过滤剔除 {len(pol_drop_set)} 条　'
          f'HC 判定 {len(hc_rows)} 条')

    # 上一交易日快照（用于识别「新增成员」）
    prev_path = os.path.join(RD, f'theme_stock_map_v2_20260923.csv')
    prev_set = {(r['主题'], r['股票代码']) for r in read_csv(prev_path)} if os.path.exists(prev_path) else set()

    theme_order, audit = [], []
    for r in pool:
        theme = r.get('theme', '').strip()
        code = r.get('code', '').strip()
        if not theme or not code:
            continue
        theme_key = key_by_cn.get(theme, '')
        cfg = cfg_by_cn.get(theme, {})
        name = r.get('name', '').strip()
        via = r.get('via', '').strip()
        industry = r.get('industry', '').strip()
        mainbiz = (mainbiz_map.get(code) or r.get('mainbiz') or '').strip()
        if theme not in theme_order:
            theme_order.append(theme)

        res = classify(theme_key, cfg, code, name, via, industry, mainbiz)
        # 当前口径：4a.47 环节门槛 / 4a.6 污染过滤 已显式剔除的，分别标记；
        # 其余为「通过全部门槛、应进入正式映射」的成员。
        # （注：磁盘 theme_stock_map_v2 对 6 个 segment_gate 主题仍是 4a.47 之前的旧产物，
        #   故不以该文件判定「生产保留」，改以门槛后口径为准。）
        if (theme, code) in seg_drop_set:
            gate = '环节门槛剔除'
        elif (theme, code) in pol_drop_set:
            gate = '污染过滤剔除'
        else:
            gate = '映射保留'
        audit.append({
            'theme': theme,
            'ts_code': code,
            'name': name,
            'mapping_old': hc_map.get((theme, code), 'NA'),
            'mapping_new': res['classification'],
            'classification': res['classification'],
            'evidence_type': res['evidence_type'],
            'evidence': res['evidence'],
            'confidence': res['confidence'],
            'manual_action': res['manual_action'],
            'reason': res['reason'],
            'gate_status': gate,
            'is_new_member': 'Y' if (theme, code) not in prev_set else '',
            'via': via,
            'industry': industry,
            'mainbiz': mainbiz[:200],
        })
    print(f'  审计条目: {len(audit)}')

    # ------------------------------------------------ TABLE 1
    by_theme = defaultdict(list)
    for a in audit:
        by_theme[a['theme']].append(a)

    t1, metrics = [], {}
    for theme in theme_order:
        rows = by_theme[theme]
        n0 = len(rows)
        c = Counter(a['classification'] for a in rows)
        core, chain = c['CORE'], c['CHAIN']
        unc, exc = c['UNCERTAIN'], c['EXCLUDE']
        final = core + chain
        h = heat_map.get(theme, {})
        _inds = set()
        for _s in (cfg_by_cn.get(theme, {}).get('segments') or []):
            _inds |= {i for i in (_s.get('industries') or []) if i}
        n_ind_member = sum(1 for a in rows if a['industry'] in _inds) if _inds else 0
        n_exc_prod = sum(1 for a in rows
                         if a['classification'] == 'EXCLUDE' and a['gate_status'] == '映射保留')
        t1.append({
            '主题': theme, '原N': n0, 'CORE': core, 'CHAIN': chain,
            'UNCERTAIN': unc, 'EXCLUDE': exc, '最终N(CORE+CHAIN)': final,
            '保留率%': round(final * 100.0 / n0, 1) if n0 else 0,
            '剔除率%': round(exc * 100.0 / n0, 1) if n0 else 0,
            'CHAIN占比%': round(chain * 100.0 / final, 1) if final else 0,
            'UNCERTAIN占比%': round(unc * 100.0 / n0, 1) if n0 else 0,
            'Today Heat': h.get('today_heat', ''), 'Week Heat': h.get('week_heat', ''),
            'Month Heat': h.get('month_heat', ''),
        })
        metrics[theme] = {
            'n0': n0, 'core': core, 'chain': chain, 'uncertain': unc, 'exclude': exc,
            'final': final,
            'keep_ratio': round(final * 100.0 / n0, 1) if n0 else 0,
            'exclude_ratio': round(exc * 100.0 / n0, 1) if n0 else 0,
            'chain_ratio': round(chain * 100.0 / final, 1) if final else 0,
            'uncertain_ratio': round(unc * 100.0 / n0, 1) if n0 else 0,
            'industry_gate': sum(1 for a in rows if a['evidence_type'] == '环节行业'),
            'seg_industry_members': n_ind_member,
            'exclude_in_prod': n_exc_prod,
            'today_heat': h.get('today_heat', ''), 'week_heat': h.get('week_heat', ''),
            'month_heat': h.get('month_heat', ''), 'today_rank': h.get('today_rank', ''),
        }

    # ------------------------------------------------ TABLE 2 异常主题
    t2 = []
    gate_themes = {k for k, v in cfg_all.items() if not k.startswith('_') and v.get('segment_gate')}
    SUGGEST = {
        '过度剔除/明显污染': '核对被剔名单：区分「主营明确属其他领域」（真剔除）与「仅行业口径纳入」（应保留待复核）',
        '剔除偏高': '抽查被剔名单，确认剔除依据是否为主营文本缺关键词（若属证据不足应转 UNCERTAIN）',
        'N 极端下降': '成员池缩减过大，须确认不是关键词覆盖面不足所致；建议补环节业务词后再收口',
        'UNCERTAIN 占比过高': 'UNCERTAIN 不进 Heat；须补录主营文本或人工判定后再定档',
        '产业链环节占比过高': '正式 Heat 纳入 CHAIN 后需确认 CHAIN 判定质量（置信度多为 MEDIUM/LOW，需人工确认）',
        '环节行业豁免过宽': '逐项核对环节行业豁免成员，须有明确经营层证据；仅「用电/泛公用事业」不得计入',
        '跨主题规则不一致': '该主题未启用环节清单门槛，与已启用主题判定口径不一致，建议纳入统一门槛',
        '生产映射含审计判 EXCLUDE 成员': '生产映射中残留行业口径纳入的成员，建议从正式成员池移除或转 UNCERTAIN 待复核',
    }
    for theme in theme_order:
        m = metrics[theme]
        has_gate = key_by_cn.get(theme, '') in gate_themes
        issues = []
        if m['exclude_ratio'] >= 60:
            issues.append(('过度剔除/明显污染', f"剔除率 {m['exclude_ratio']}%（{m['exclude']}/{m['n0']}）", 'HIGH'))
        elif m['exclude_ratio'] >= 45:
            issues.append(('剔除偏高', f"剔除率 {m['exclude_ratio']}%（{m['exclude']}/{m['n0']}）", 'MEDIUM'))
        if m['n0'] and m['keep_ratio'] <= 35:
            issues.append(('N 极端下降', f"最终N {m['final']}/{m['n0']}（保留率 {m['keep_ratio']}%）", 'HIGH'))
        if m['uncertain_ratio'] >= 25:
            issues.append(('UNCERTAIN 占比过高', f"UNCERTAIN {m['uncertain']}/{m['n0']}（{m['uncertain_ratio']}%）", 'MEDIUM'))
        if m['final'] and m['chain_ratio'] >= 70:
            issues.append(('产业链环节占比过高', f"CHAIN/最终N = {m['chain_ratio']}%", 'MEDIUM'))
        if m['seg_industry_members'] >= 20:
            issues.append(('环节行业豁免过宽',
                           f"环节行业豁免 {m['seg_industry_members']} 条"
                           f"（审计判定需经营层证据的 {m['industry_gate']} 条）", 'HIGH'))
        if m['exclude_in_prod'] >= 10:
            issues.append(('生产映射含审计判 EXCLUDE 成员',
                           f"当前生产映射保留 {m['exclude_in_prod']} 条审计判 EXCLUDE 的成员", 'HIGH'))
        if not has_gate and m['n0'] >= 100 and m['exclude_ratio'] < 25:
            issues.append(('跨主题规则不一致', '该主题未启用环节清单门槛，剔除率显著低于已启用主题', 'MEDIUM'))
        for q, ev, sev in issues:
            t2.append({'主题': theme, '问题': q, '证据': ev, '严重程度': sev,
                       '建议': SUGGEST.get(q, '')})

    # ------------------------------------------------ TABLE 3 人工审核清单
    t3 = []
    for a in audit:
        risky = (a['classification'] == 'UNCERTAIN'
                 or (a['classification'] == 'CHAIN' and a['confidence'] != 'HIGH')
                 or (a['classification'] == 'EXCLUDE' and a['manual_action'] == 'REVIEW'))
        if not risky:
            continue
        t3.append({
            '主题': a['theme'], '代码': a['ts_code'], '名称': a['name'],
            '分类': a['classification'], '证据类型': a['evidence_type'],
            '证据': a['evidence'], '置信度': a['confidence'],
            '人工动作': a['manual_action'], '原因': a['reason'],
            '原映射(HC)': a['mapping_old'], '门槛状态': a['gate_status'],
        })

    # ------------------------------------------------ TABLE 4
    t4 = []
    for theme in theme_order:
        m = metrics[theme]
        delta = m['final'] - m['n0']
        t4.append({
            '主题': theme, '原N': m['n0'], '新N(CORE+CHAIN)': m['final'], '变化': delta,
            '变化幅度%': round(delta * 100.0 / m['n0'], 1) if m['n0'] else 0,
            'Today Heat变化': '待重算', 'Week Heat变化': '待重算', 'Month Heat变化': '待重算',
            '是否可能影响排名': ('可能（变动≥20%）' if m['n0'] and abs(delta) * 100.0 / m['n0'] >= 20
                            else ('轻微（变动5%~20%）' if abs(delta) * 100.0 / m['n0'] >= 5 else '基本无影响')),
            '当前Today Heat': m['today_heat'], '当前Today排名': m['today_rank'],
        })

    # ------------------------------------------------ 随机抽样
    rnd = random.Random(RANDOM_SEED)
    samples = []
    for theme in theme_order:
        rows = by_theme[theme]
        for cls in ('CORE', 'CHAIN', 'UNCERTAIN', 'EXCLUDE'):
            grp = [a for a in rows if a['classification'] == cls]
            rnd.shuffle(grp)
            for a in grp[:SAMPLE_N]:
                samples.append({
                    '主题': theme, '代码': a['ts_code'], '名称': a['name'], '分类': cls,
                    '证据': a['evidence'], '置信度': a['confidence'],
                    '人工动作': a['manual_action'], '主营文本': a['mainbiz'],
                })

    # ------------------------------------------------ 电力「环节行业豁免」全量诊断（规格 §五-4）
    # 规格：逐项检查环节行业豁免成员；「只是用电」绝不能算电力主题成员。
    _pw_inds = set()
    for _seg in (cfg_by_cn.get('电力', {}).get('segments') or []):
        _pw_inds |= {i for i in (_seg.get('industries') or []) if i}
    pw_audit = []
    for a in by_theme.get('电力', []):
        if a['industry'] not in _pw_inds:
            continue
        mb_full = mainbiz_map.get(a['ts_code'], '') or ''
        biz_hit = [w for w in POWER_BIZ_WORDS if w in mb_full]
        pw_audit.append({
            '主题': '电力', '代码': a['ts_code'], '名称': a['name'], '原分类': a['classification'],
            '证据类型': a['evidence_type'], '置信度': a['confidence'],
            '人工动作': a['manual_action'], '行业': a['industry'],
            '电力经营词': '|'.join(biz_hit),
            '主营文本': mb_full[:160], '门槛状态': a['gate_status'],
        })

    # ------------------------------------------------ 写文件
    print('\n[输出]')
    audit_fields = ['theme', 'ts_code', 'name', 'mapping_old', 'mapping_new', 'classification',
                    'evidence_type', 'evidence', 'confidence', 'manual_action', 'reason',
                    'gate_status', 'is_new_member', 'via', 'industry', 'mainbiz']
    write_csv(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}.csv'), audit_fields, audit)
    write_csv(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}_table1.csv'),
              list(t1[0].keys()), t1)
    write_csv(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}_table2.csv'),
              ['主题', '问题', '证据', '严重程度', '建议'], t2)
    write_csv(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}_table3.csv'),
              list(t3[0].keys()) if t3 else ['主题'], t3)
    write_csv(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}_table4.csv'),
              list(t4[0].keys()), t4)
    write_csv(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}_samples.csv'),
              list(samples[0].keys()) if samples else ['主题'], samples)
    if pw_audit:
        write_csv(os.path.join(RD, f'theme_mapping_v3_power_industry_gate_{TRADE_DATE}.csv'),
                  list(pw_audit[0].keys()), pw_audit)

    members = [{'theme': a['theme'], 'ts_code': a['ts_code'], 'name': a['name'],
                'classification': a['classification'], 'confidence': a['confidence']}
               for a in audit if a['classification'] in ('CORE', 'CHAIN')]
    write_csv(os.path.join(RD, f'theme_mapping_v3_members_{TRADE_DATE}.csv'),
              ['theme', 'ts_code', 'name', 'classification', 'confidence'], members)

    with open(os.path.join(RD, f'theme_mapping_v3_{TRADE_DATE}_summary.json'), 'w',
              encoding='utf-8') as f:
        json.dump({'trade_date': TRADE_DATE, 'metrics': metrics,
                   'table2': t2}, f, ensure_ascii=False, indent=2)
    print(f'  -> theme_mapping_v3_{TRADE_DATE}_summary.json')

    # ------------------------------------------------ 控制台摘要
    print('\n' + '=' * 68)
    print('TABLE 1  Mapping Quality')
    print('=' * 68)
    hdr = f"{'主题':<10}{'原N':>5}{'CORE':>6}{'CHAIN':>6}{'UNCT':>6}{'EXCL':>6}{'最终N':>7}{'保留%':>7}{'剔%':>7}{'CHAIN%':>8}{'UNCT%':>7}"
    print(hdr)
    for r in t1:
        print(f"{r['主题']:<10}{r['原N']:>5}{r['CORE']:>6}{r['CHAIN']:>6}{r['UNCERTAIN']:>6}"
              f"{r['EXCLUDE']:>6}{r['最终N(CORE+CHAIN)']:>7}{r['保留率%']:>7}{r['剔除率%']:>7}"
              f"{r['CHAIN占比%']:>8}{r['UNCERTAIN占比%']:>7}")

    print('\nTABLE 2  异常主题')
    for r in t2:
        print(f"  [{r['严重程度']:<6}] {r['主题']:<10}{r['问题']:<18}{r['证据']}")

    print('\n重点主题明细')
    for theme in ('AI算力', '智能驾驶', '军工', '电力', '消费'):
        m = metrics.get(theme)
        if not m:
            continue
        rows = by_theme[theme]
        c = Counter(a['classification'] for a in rows)
        ev = Counter(a['evidence_type'] for a in rows if a['classification'] in ('CHAIN', 'EXCLUDE'))
        drop = sum(1 for a in rows if a['gate_status'] == '环节门槛剔除')
        print(f"  {theme}: 原N={m['n0']} 环节门槛剔除={drop} | CORE={c['CORE']} CHAIN={c['CHAIN']} "
              f"UNCERTAIN={c['UNCERTAIN']} EXCLUDE={c['EXCLUDE']} | 环节行业豁免={m['industry_gate']}")
        print(f"      CHAIN/EXCLUDE 证据类型分布: {dict(ev)}")
        exc_rows = [a for a in rows if a['classification'] == 'EXCLUDE']
        print(f"      EXCLUDE={len(exc_rows)} 证据类型={dict(Counter(a['evidence_type'] for a in exc_rows))} "
              f"门槛状态={dict(Counter(a['gate_status'] for a in exc_rows))} "
              f"通道={dict(Counter(a['via'] for a in exc_rows).most_common(5))}")
        for a in exc_rows[:8]:
            print(f"        [EXCL·{a['evidence_type']}] {a['ts_code']} {a['name']}"
                  f"（{a['industry']}/{a['via']}）{a['mainbiz'][:46]}")

    print(f"\n  电力·环节行业豁免（行业∈环节窄口径行业）全量 {len(pw_audit)} 条　"
          f"行业分布: {dict(Counter(a['行业'] for a in pw_audit))}")
    pw_cls = Counter(a['原分类'] for a in pw_audit)
    pw_nobiz = [a for a in pw_audit if not a['电力经营词']]
    print(f"      判定分布: {dict(pw_cls)}　其中无电力经营词（仅行业口径）{len(pw_nobiz)} 条")
    for a in pw_nobiz[:40]:
        print(f"      [仅行业口径] {a['代码']} {a['名称']}（{a['行业']}）"
              f"{a['原分类']}/{a['人工动作']} {a['主营文本'][:52]}")
    if len(pw_nobiz) > 40:
        print(f"      ... 其余 {len(pw_nobiz) - 40} 条见 power_industry_gate csv")

    print(f"\n  人工审核清单（TABLE 3）: {len(t3)} 条")
    for theme in ('AI算力', '智能驾驶', '军工', '电力', '消费'):
        rows = [a for a in by_theme.get(theme, [])
                if a['classification'] == 'UNCERTAIN'
                or (a['classification'] == 'CHAIN' and a['confidence'] != 'HIGH')
                or (a['classification'] == 'EXCLUDE' and a['manual_action'] == 'REVIEW')]
        cc = Counter(a['classification'] for a in rows)
        print(f"    {theme}: {len(rows)} 条 {dict(cc)}")

    g_exc_prod = [a for a in audit if a['classification'] == 'EXCLUDE' and a['gate_status'] == '映射保留']
    g_exc_gate = [a for a in audit if a['classification'] == 'EXCLUDE' and a['gate_status'] == '环节门槛剔除']
    g_rescue = [a for a in audit if a['gate_status'] == '环节门槛剔除'
                and a['classification'] in ('CORE', 'CHAIN')]
    print(f"\n  全局：审计判 EXCLUDE 且仍保留在生产映射 {len(g_exc_prod)} 条"
          f"（{dict(Counter(a['theme'] for a in g_exc_prod))}）")
    print(f"  全局：审计判 EXCLUDE 且被环节门槛剔除 {len(g_exc_gate)} 条")
    print(f"  全局：被环节门槛剔除但审计判 CORE/CHAIN（疑似过度剔除）{len(g_rescue)} 条"
          f"（{dict(Counter(a['theme'] for a in g_rescue))}）")

    print('\n完成。')


if __name__ == '__main__':
    main()
