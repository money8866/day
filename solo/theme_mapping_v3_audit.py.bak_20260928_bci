def text_status(txt):
    """EMPTY / TOOSHORT / BOILERPLATE / ''（可用）"""
    t = (txt or '').strip()
    if not t:
        return 'EMPTY'
    if len(t) < 12:
        return 'TOOSHORT'
    if any(b in t for b in TEXT_BOILERPLATE):
        return 'BOILERPLATE'
    return ''


