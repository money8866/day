# ---------------------------------------------------------------- 7 渲染
def render_txt(ex, idx, plans, watch_n, events, scen, news) -> str:
    L = []
    L.append(f"当天操作推演 | {TODAY_CN}（{'一二三四五六日'[dt.date.fromisoformat(TODAY_CN).weekday()]}）")
    L.append("")
    # ① 外围
    a50 = ex.get("a50")
    a50_txt = "A50 期指：暂缺"
    if a50:
        try:
            last, pre = float(a50.get("last")), float(a50.get("pre_settle"))
            chg_v = (last - pre) / pre * 100 if pre else None
            a50_txt = f"A50 期指：{last:.2f}（{chg_v:+.2f}% vs 前收 {pre:.0f}）"
        except (TypeError, ValueError):
            a50_txt = "A50 期指：解析失败"
    hsgt_n = 0
    try:
        hsgt_n = 0 if ex.get("hsgt") is None else len(ex["hsgt"])
    except Exception:
        hsgt_n = 0
    L.append(f"① 夜盘与外围：{a50_txt}；北向实时：{'在更' if hsgt_n else '暂缺'}；"
             f"隔夜要闻 {len(news)} 条命中 A 股关键词。")
    L.append("")
    # ② 大盘技术位
    L.append("② 大盘技术位（腾讯实时日K，cache_daily 回退）：")
    for st in idx:
        ma = f"MA5 {fmt(st['ma5'])} / MA10 {fmt(st['ma10'])} / MA20 {fmt(st['ma20'])}"
        vol_txt = ""
        if st.get("vol_ma5"):
            vol_txt = f"；量能 {st['vol_last']/st['vol_ma5']*100:.0f}%的5日均量"
        L.append(f"  {st['name']}：现 {fmt(st['close'])}（{st['chg_last']:+.2f}%），{ma}；"
                 f"近20日区间 {fmt(st['lo20'])}~{fmt(st['hi20'])}{vol_txt}；"
                 f"数据截至 {st['last_date'][:4]}-{st['last_date'][4:6]}-{st['last_date'][6:]}（{st['src']}）")
    L.append("")
    # ③ 昨日情绪
    zt = ex.get("hot") or []
    hot_txt = ("、".join(str(h.get("name") or h.get("stock_name") or "?") for h in zt[:5])
               if zt else "暂缺（东财人气榜接口异常）")
    cls_n = len(ex.get("cls") or [])
    L.append(f"③ 情绪与热点：热榜 {len(zt)} 只（{hot_txt}）；财联社电报 {cls_n} 条。")
    L.append("")
    # ④ 隔夜要闻
    L.append("④ 隔夜要闻（与 A 股相关度排序）：")
    for i, (s, t, d) in enumerate(news[:10], 1):
        brief = (d or t)[:70]
        L.append(f"  {i}. {t}｜{brief}")
    if not news:
        L.append("  （暂无命中资讯，接口可能暂缺）")
    L.append("")
    # ⑤ 今日事件雷区
    L.append("⑤ 今日事件雷区（按时间排，避开/利用）：")
    ev_n = 0
    mc = events.get("macro")
    if mc is not None and len(mc):
        rows_mc = mc.to_dict("records") if hasattr(mc, "to_dict") else mc
        for row in rows_mc:
            t = str(row.get("time") or "")
            try:  # UTC -> 北京 +8h
                tt = dt.datetime.fromisoformat(t) + dt.timedelta(hours=8)
                t_show = tt.strftime("%H:%M")
            except Exception:
                t_show = t[-5:]
            title = str(row.get("title") or "")
            imp = row.get("importance") or 0
            star = "★" * int(imp) if str(imp).isdigit() else ""
            extra = ""
            if row.get("actual") not in (None, "") and str(row.get("actual")) != "nan":
                extra = f" 实际{row.get('actual')}"
                if row.get("forecast") not in (None, "") and str(row.get("forecast")) != "nan":
                    extra += f"/预期{row.get('forecast')}"
            if title:
                L.append(f"  宏观 {t_show} {star} {title}{extra}")
                ev_n += 1
            if ev_n >= 10:
                break
    ef = events.get("earnings")
    if ef is not None and len(ef):
        cnt = 0
        rows_ef = ef.to_dict("records") if hasattr(ef, "to_dict") else ef
        for row in rows_ef[:200]:
            d = str(row.get("report_date") or row.get("publish_date") or "")
            if TODAY_CN.replace("-", "") in d.replace("-", "") or TODAY_CN in d:
                nm = row.get("name") or row.get("stock_name") or row.get("code") or ""
                L.append(f"  财报 {nm}（{d[:10]}）")
                cnt += 1
                if cnt >= 6:
                    break
        ev_n += cnt
    lk = events.get("lockup")
    rows_lk = []
    if isinstance(lk, dict):
        rows_lk = lk.get("upcoming") or lk.get("history") or []
    elif lk is not None:
        try:
            rows_lk = lk.to_dict("records") if hasattr(lk, "to_dict") else list(lk)
        except Exception:
            rows_lk = []
    for row in rows_lk[:4]:
        nm = row.get("name") or row.get("stock_name") or ""
        cd = row.get("code") or ""
        ratio = row.get("ratio") or row.get("unlock_ratio") or row.get("lift_ratio") or ""
        sh = row.get("shares") or row.get("unlock_shares") or ""
        L.append(f"  解禁 {nm}({cd})" + (f" 占比{ratio}%" if ratio else "")
                 + (f" {sh}股" if sh else ""))
        ev_n += 1
    if not ev_n:
        L.append("  今日无重大事件日历（或接口暂缺），按常态节奏应对。")
    L.append("")
    # ⑥ 自选股推演
    L.append(f"⑥ 自选股操作预案（{watch_n} 只自选，重点 {len(plans)} 只；自选价为最近导出快照，"
             f"技术位取腾讯实时日K）：")
    for p in plans:
        head = f"  {p['name']}({p['code']}) 现{p['px'] or fmt(p.get('close'))} {p['chg'] or ''}%"
        tail = f"｜{p['trend']}｜{p['action']}｜{p['trig']}"
        extra = ""
        if p.get("macd"):
            extra += f"｜MACD:{p['macd']}"
        if p.get("score"):
            extra += f"｜评分{p['score']}"
        L.append(head + tail + extra)
        L.append(f"      理由：{p['why']}")
    L.append("")
    # ⑦ 三情景
    L.append("⑦ 全天三情景推演与应对：")
    for s in scen:
        L.append(f"  【{s['name']}】概率 {s['prob']}")
        L.append(f"      应对：{s['act']}")
    L.append("")
    # ⑧ 总纲
    L.append("⑧ 一句话总纲与仓位：")
    sh = next((x for x in idx if x["name"] == "上证指数"), None)
    if sh and sh.get("ma5"):
        pos = "站上" if sh["close"] >= sh["ma5"] else "跌破"
        L.append(f"  上证 {fmt(sh['close'])} {pos} 5 日线 {fmt(sh['ma5'])}；"
                 f"深创低点未创新低前按反弹对待，创新低按二次探底对待。")
    L.append("  节奏：早盘 9:30-10:00 定方向，10:00 前不重仓押注；"
             "午盘 11:00-11:20 与尾盘 14:30-15:00 为关键决策窗；"
             "单日总仓位上限五成，单票不超过两成，设好止损再动手。")
    L.append("")
    L.append("以上内容基于公开数据与规则引擎生成，仅供参考，不构成投资建议。市场有风险，投资需谨慎。")
    return "\n".join(L)


def render_html(txt: str) -> str:
    """txt -> 邮件 HTML（20px 内联样式，与既有复盘邮件一致）"""
    def esc(s):
        return html.escape(s, quote=False)

    body = []
    for line in txt.splitlines():
        if not line.strip():
            continue
        s = esc(line)
        if line.startswith("当天操作推演"):
            body.append(f'<div style="font-size:26px;font-weight:700;color:#1a1a2e;'
                        f'margin:0 0 18px 0;padding-bottom:12px;'
                        f'border-bottom:3px solid #e94560;">{s}</div>')
        elif re.match(r"^[①②③④⑤⑥⑦⑧]", line):
            body.append(f'<div style="font-size:21px;font-weight:700;color:#e94560;'
                        f'margin:20px 0 10px 0;">{s}</div>')
        elif re.match(r"^  【", line):
            body.append(f'<div style="font-size:20px;font-weight:600;color:#0f3460;'
                        f'margin:12px 0 4px 0;">{s.strip()}</div>')
        elif line.startswith("      "):
            body.append(f'<div style="font-size:18px;color:#555;margin:2px 0 2px 18px;">'
                        f'{s.strip()}</div>')
        elif line.startswith("  "):
            body.append(f'<div style="font-size:19px;color:#222;margin:6px 0;'
                        f'line-height:1.6;">{s.strip()}</div>')
        else:
            body.append(f'<div style="font-size:19px;color:#222;margin:6px 0;'
                        f'line-height:1.6;">{s}</div>')
    return (
        '<html><body style="margin:0;padding:24px;background:#f5f6fa;'
        'font-family:\'Microsoft YaHei\',\'PingFang SC\',sans-serif;">'
        '<div style="max-width:860px;margin:0 auto;background:#ffffff;'
        'border-radius:12px;padding:32px 36px;'
        'box-shadow:0 2px 12px rgba(0,0,0,0.08);">'
        + "".join(body) +
        '<div style="margin-top:28px;padding-top:14px;border-top:1px solid #ddd;'
        'font-size:15px;color:#999;">由 mystock _trade_plan.py 自动生成 · '
        f'{time.strftime("%Y-%m-%d %H:%M")}</div>'
        '</div></body></html>'
    )


# ---------------------------------------------------------------- 主流程
def main():
    global TODAY_TAG, TODAY_CN
    day = sys.argv[1] if len(sys.argv) > 1 else time.strftime("%Y%m%d")
    TODAY_TAG = day
    TODAY_CN = f"{day[:4]}-{day[4:6]}-{day[6:]}"
    t0 = time.time()
    log(f"=== 当天操作推演生成 {TODAY_CN} ===")

    watch = load_watchlist()
    scores = load_volma_scores()

    log("== 外围与资讯 ==")
    ex = fetch_external()
    news = top_news(ex)

    log("== 今日事件 ==")
    events = fetch_events(day)

    log("== 大盘技术位 ==")
    idx = index_block()
    log(f"  指数 {len(idx)} 个就绪")

    log("== 自选股推演 ==")
    plans, watch_n = stock_block(watch, scores)
    log(f"  重点预案 {len(plans)} 只")

    log("== 三情景 ==")
    scen = scenario_block(ex, idx)

    txt = render_txt(ex, idx, plans, watch_n, events, scen, news)
    htm = render_html(txt)

    out_txt = os.path.join(OUT_DIR, f"trade-plan-{day}.txt")
    out_html = os.path.join(OUT_DIR, f"trade-plan-{day}.html")
    with open(out_txt, "w", encoding="utf-8") as f:
        f.write(txt)
    with open(out_html, "w", encoding="utf-8") as f:
        f.write(htm)

    log(f"=== 完成 {time.time()-t0:.1f}s ===")
    log(f"产物：{out_txt}")
    log(f"      {out_html}")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        traceback.print_exc()
        sys.exit(1)
