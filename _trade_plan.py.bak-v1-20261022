def load_watchlist() -> list[dict]:
    """东财自选 CSV -> [{name, code, mkt}]"""
    rows = []
    try:
        with open(SELF_SELECT, encoding="utf-8-sig") as f:
            r = csv.reader(f)
            next(r, None)
            for row in r:
                if len(row) < 2 or not row[0].strip():
                    continue
                m = re.search(r"\d{6}", row[1])
                if not m:
                    continue
                code = m.group(0)
                mkt = row[2].strip().upper() if len(row) > 2 else ""
                if not mkt:
                    mkt = "SH" if code.startswith("6") else "SZ"
                rows.append({"name": row[0].strip(), "code": code, "mkt": mkt,
                             "px": (row[3].strip() if len(row) > 3 else ""),
                             "chg": (row[4].strip() if len(row) > 4 else "")})
    except Exception as e:
        log(f"  [自选] 读取失败 {type(e).__name__}")
    log(f"  自选股 {len(rows)} 只")
    return rows


def load_volma_scores() -> dict:
