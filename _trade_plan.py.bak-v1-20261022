                     "act": "若放量收复 5 日线可试仓强势板块；只做最强的那一个方向。"})
        scen.append({"name": "低位震荡（磨底）", "prob": "25%",
                     "act": "区间下沿分批，单一标的不超过计划仓位一半。"})
        scen.append({"name": "继续单边下跌", "prob": "15%",
                     "act": "破昨日低点止损离场，等右侧信号，不猜底。"})
    else:
