# ---------------------------------------------------------------- 工具
def safe(fn, default=None, tag=""):
    """统一容错：外部接口失败只返回默认值并打标"""
    try:
        return fn()
    except Exception as e:
        log(f"  [缺数据] {tag or fn.__name__ if hasattr(fn, '__name__') else tag}: "
            f"{type(e).__name__} {str(e)[:80]}")
        return default


def tx_to_ts(code_tx: str) -> str:
    """腾讯码 -> tushare 码：sh000001 -> 000001.SH"""
    m = re.match(r"^(sh|sz)(\d{6})$", code_tx or "")
    if not m:
        return code_tx
    return f"{m.group(2)}.{m.group(1).upper()}"


def kline_tech(code_tx: str, n: int = 60) -> tuple[pd.DataFrame | None, str]:
    """近期日K：腾讯源优先（实时），cache_daily 回退。
    返回 (df, 来源标注)。缓存超过 10 个自然日未更新会在标注里体现。"""
    df = safe(lambda: A.tencent_kline(code_tx, period="day", count=n + 10),
              None, f"tencent_kline {code_tx}")
    if df is not None and len(df) >= 5:
        d = df.rename(columns={"date": "trade_date"}).copy()
        d["trade_date"] = d["trade_date"].astype(str).str.replace("-", "", regex=False)
        return d.sort_values("trade_date").reset_index(drop=True), "腾讯实时"
    dc = load_daily(tx_to_ts(code_tx))
    if dc is not None and len(dc) >= 5:
        last = str(dc["trade_date"].iloc[-1])
        try:
            gap = (dt.date.today() - dt.date(int(last[:4]), int(last[4:6]), int(last[6:]))).days
        except Exception:
            gap = -1
        tag = f"缓存(截至{last[:4]}-{last[4:6]}-{last[6:]}" + (f",旧{gap}天" if gap > 10 else "") + ")"
        return dc, tag
    return None, "无数据"


def _norm_cols(df: pd.DataFrame) -> pd.DataFrame:
    """cache_daily 列名归一化：兼容 vol/volume、amt/amount、chg/pct_chg 等差异"""
    ren = {}
    for c in df.columns:
        cl = str(c).strip().lower()
        if cl in ("vol", "volume", "vol_") and "volume" not in df.columns:
            ren[c] = "volume"
        elif cl in ("amt", "amount", "amount_") and "amount" not in df.columns:
            ren[c] = "amount"
        elif cl in ("chg", "pct_chg", "pctchange", "change_pct") and "pct_chg" not in df.columns:
            ren[c] = "pct_chg"
    return df.rename(columns=ren) if ren else df


def load_daily(code_ts: str) -> pd.DataFrame | None:
    """读日K缓存，兼容 000001_SH.csv 与 000001.SH.csv 两种命名"""
    stem = code_ts.replace(".", "_")
    dotted = code_ts
    for cand in (os.path.join(CACHE_DAILY, stem + ".csv"),
                 os.path.join(CACHE_DAILY, dotted + ".csv")):
        if os.path.exists(cand):
            try:
                df = pd.read_csv(cand)
                if df.empty:
                    return None
                df["trade_date"] = df["trade_date"].astype(str)
                df = _norm_cols(df)
                return df.sort_values("trade_date").reset_index(drop=True)
            except Exception:
                return None
    return None


def tech_stats(df: pd.DataFrame | None, n: int = 20):
    """日K -> 技术位摘要（MA5/10/20、近 n 日高低点、量能、连涨跌）"""
    if df is None or len(df) < 5:
        return None
    c = df["close"].astype(float)
    v = df["volume"].astype(float) if "volume" in df.columns else None
    out = {
        "close": float(c.iloc[-1]),
        "ma5": float(c.rolling(5).mean().iloc[-1]) if len(c) >= 5 else None,
        "ma10": float(c.rolling(10).mean().iloc[-1]) if len(c) >= 10 else None,
        "ma20": float(c.rolling(20).mean().iloc[-1]) if len(c) >= 20 else None,
        "hi20": float(df["high"].astype(float).tail(n).max()) if "high" in df.columns else None,
        "lo20": float(df["low"].astype(float).tail(n).min()) if "low" in df.columns else None,
        "vol_ma5": float(v.rolling(5).mean().iloc[-1]) if v is not None and len(v) >= 5 else None,
        "vol_last": float(v.iloc[-1]) if v is not None else None,
        "chg_last": (float(c.iloc[-1] / c.iloc[-2] - 1) * 100
                     if "pct_chg" not in df.columns and len(c) >= 2
                     else (float(df["pct_chg"].astype(float).iloc[-1])
                           if "pct_chg" in df.columns else 0.0)),
        "dates": len(df),
    }
    # 连涨/连跌天数（无 pct_chg 列时用收盘价差分）
    if "pct_chg" in df.columns:
        chg = df["pct_chg"].astype(float).tolist()
    else:
        cc = c.tolist()
        chg = [0.0] + [(cc[i] - cc[i - 1]) / cc[i - 1] * 100 if cc[i - 1] else 0.0
                       for i in range(1, len(cc))]
    streak = 0
    for x in reversed(chg):
        if x > 0:
            streak = streak + 1 if streak >= 0 else 1
        elif x < 0:
            streak = streak - 1 if streak <= 0 else -1
        else:
            break
    out["streak"] = streak
    return out


def fmt(v, nd=2):
    return f"{v:.{nd}f}" if isinstance(v, (int, float)) and v is not None else "-"


