            last, pre = float(last), float(pre)
            if pre:
                a50_chg = (last - pre) / pre * 100
        except (TypeError, ValueError):
            a50_chg = None
    sh = next((x for x in idx if x["name"] == "上证指数"), None)
    close5 = sh["ma5"] if sh and sh.get("ma5") else None
