# ---------------------------------------------------------------- 5 自选股推演
def plan_rule(st: dict, price: float | None) -> dict:
    """规则引擎：均线结构 + 关键位 + 偏离度 -> 动作/触发位/理由"""
    ma5, ma10, ma20 = st.get("ma5"), st.get("ma10"), st.get("ma20")
    hi20, lo20 = st.get("hi20"), st.get("lo20")
    p = price if price else st["close"]
    dev20 = (p - ma20) / ma20 * 100 if ma20 else 0.0

    if None in (ma5, ma10, ma20):
        return {"trend": "数据不足", "action": "观察", "trig": "-", "why": "缓存不足，按现价观察"}

    if p > ma5 > ma10 > ma20:
        trend = "多头排列"
        if dev20 > 18:
            action, why = "持有不追", "多头但偏离 20 日线过大，回踩再看"
            trig = f"回踩 {fmt(ma5)} 不破可低吸；跌破 {fmt(ma10)} 减"
        else:
            action, why = "持有/回踩低吸", "均线多头排列，趋势未破"
            trig = f"守 {fmt(ma5)} 持有；失守 {fmt(ma10)} 减半"
    elif p < ma5 < ma10 < ma20:
        trend = "空头排列"
        action, why = "反抽减仓/回避", "均线空头，不接飞刀"
        trig = f"反抽 {fmt(ma5)}~{fmt(ma10)} 压力减仓；站回 {fmt(ma20)} 再谈修复"
    else:
        trend = "震荡"
        pos = (p - lo20) / (hi20 - lo20) * 100 if hi20 > lo20 else 50
        if pos < 25:
            action, why = "区间下沿试仓", "震荡区间下沿，盈亏比好"
            trig = f"{fmt(lo20)} 附近试；跌破 {fmt(lo20*0.98)} 止损"
        elif pos > 75:
            action, why = "区间上沿兑现", "震荡区间上沿，先兑现再看"
            trig = f"{fmt(hi20)} 附近减；放量破 {fmt(hi20)} 再追"
        else:
            action, why = "持有观察", "区间中段，等方向"
            trig = f"{fmt(lo20)}~{fmt(hi20)} 区间操作"
    # 极端偏离修正
    if dev20 > 25:
        action, why = "不追高", "偏离 20 日线超 25%，波动会放大"
    elif dev20 < -15:
        action = action + "（超跌）"
        why += "；已深度超跌，仅做反抽不做反转"
    return {"trend": trend, "action": action, "trig": trig, "why": why, "dev20": dev20}


def stock_block(watch: list[dict], scores: dict) -> tuple[list[dict], int]:
    """重点池：异动 Top（涨跌幅绝对值）+ 评分 Top，去重约 18 只"""
    def abs_chg(r):
        try:
            return abs(float(r["chg"]))
        except Exception:
            return -1
    by_move = sorted([r for r in watch if abs_chg(r) > 0],
                     key=abs_chg, reverse=True)[:12]
    pool_codes = {r["code"] for r in by_move}
    scored = sorted(scores.items(), key=lambda kv: -(kv[1].get("score") or 0))
    extra = []
    for code, meta in scored:
        if code not in pool_codes:
            extra.append((code, meta))
        if len(extra) >= 6:
            break
    name_map = {r["code"]: r for r in watch}
    for code, meta in extra:
        if code in name_map:
            by_move.append(name_map[code])
            pool_codes.add(code)

    plans = []
    for r in by_move:
        tx = f"{'sh' if r['mkt'] == 'SH' else 'sz'}{r['code']}"
        df, src = kline_tech(tx, 60)
        st = tech_stats(df, 20)
        meta = scores.get(f'{r["code"]}.{r["mkt"]}') or scores.get(r["code"]) or {}
        if not st:
            plans.append({"name": r["name"], "code": r["code"], "px": r["px"],
                          "chg": r["chg"], "trend": "无K线数据", "action": "观察",
                          "trig": "-", "why": "实时与缓存均未取到，仅按自选价观察",
                          "dev20": None, "score": meta.get("score"),
                          "macd": meta.get("macd_status")})
            continue
        price = None
        try:
            price = float(r["px"]) if r["px"] else None
        except Exception:
            pass
        rule = plan_rule(st, price)
        rule.update({"name": r["name"], "code": r["code"], "px": r["px"],
                     "chg": r["chg"], "close": st["close"], "streak": st["streak"],
                     "score": meta.get("score"), "macd": meta.get("macd_status"),
                     "src": src})
        plans.append(rule)
    return plans, len(watch)


